# ===================================
# Mars Engineering Backend — Environment Variables
# ===================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ===================================

# Server
PORT=3000

# Encryption key for PII at rest (generate a random 32-byte hex string)
# You can generate one by running:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Gmail SMTP credentials for sending email notifications
# IMPORTANT: You must use a Gmail "App Password", NOT your regular password.
# Steps:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Generate an App Password for "Mail" → "Other (Custom name)" → "Mars Engineering"
#   5. Copy the 16-character password below (no spaces)
GMAIL_USER=marsesolutions09@gmail.com
GMAIL_APP_PASSWORD=

# Client notification email (receives inquiry alerts)
CLIENT_EMAIL=marsesolutions09@gmail.com
